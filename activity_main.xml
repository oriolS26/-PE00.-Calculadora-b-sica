<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/textCalculadora"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Calculadora"
        android:textSize="24sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp" />

    <TextView
        android:id="@+id/viewOperandoA"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Operando A"
        app:layout_constraintTop_toBottomOf="@id/textCalculadora"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="30dp"
        android:layout_marginStart="30dp" />

    <EditText
        android:id="@+id/editOperandoA"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:hint="Introdueix un número"
        android:inputType="numberDecimal"
        app:layout_constraintTop_toBottomOf="@id/viewOperandoA"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp" />

    <TextView
        android:id="@+id/viewOperandoB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Operando B"
        app:layout_constraintTop_toBottomOf="@id/editOperandoA"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginStart="30dp" />

    <EditText
        android:id="@+id/editOperandoB"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:hint="Introdueix un número"
        android:inputType="numberDecimal"
        app:layout_constraintTop_toBottomOf="@id/viewOperandoB"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp" />

    <Button
        android:id="@+id/btnSuma"
        android:layout_width="68dp"
        android:layout_height="70dp"
        android:text="+"
        app:layout_constraintTop_toBottomOf="@id/editOperandoB"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="25dp"
        android:layout_marginStart="30dp" />

    <Button
        android:id="@+id/btnResta"
        android:layout_width="68dp"
        android:layout_height="70dp"
        android:text="-"
        app:layout_constraintTop_toBottomOf="@id/editOperandoB"
        app:layout_constraintStart_toEndOf="@id/btnSuma"
        android:layout_marginTop="25dp"
        android:layout_marginStart="15dp" />

    <Button
        android:id="@+id/btnMultiplicacio"
        android:layout_width="68dp"
        android:layout_height="70dp"
        android:text="*"
        app:layout_constraintTop_toBottomOf="@id/editOperandoB"
        app:layout_constraintStart_toEndOf="@id/btnResta"
        android:layout_marginTop="25dp"
        android:layout_marginStart="15dp" />

    <Button
        android:id="@+id/btnDivisio"
        android:layout_width="68dp"
        android:layout_height="70dp"
        android:text="/"
        app:layout_constraintTop_toBottomOf="@id/editOperandoB"
        app:layout_constraintStart_toEndOf="@id/btnMultiplicacio"
        android:layout_marginTop="25dp"
        android:layout_marginStart="15dp" />

    <TextView
        android:id="@+id/viewResultat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Resultat"
        app:layout_constraintTop_toBottomOf="@id/btnSuma"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="30dp"
        android:layout_marginStart="30dp" />

    <EditText
        android:id="@+id/editResultat"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:hint="Resultat"
        android:inputType="numberDecimal"
        android:focusable="false"
        app:layout_constraintTop_toBottomOf="@id/viewResultat"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp" />

</androidx.constraintlayout.widget.ConstraintLayout>